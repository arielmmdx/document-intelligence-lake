          <mxGeometry x="16" y="12" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legb" value="<b>T1</b> Sensor waits on S3 landing. Checksum becomes the DAG idempotency key.<br><br><b>T2–T3</b> ECS Python classifier. Branch: PDF, Excel, SQLite/Word, or quarantine.<br><br><b>T4</b> Workers, never the MWAA node. Mapped ECS + Textract for huge PDFs. Glue PySpark for large Excel. Python paging for SQLite.<br><br><b>T5–T6</b> Glue PySpark writes Iceberg silver then gold. Types, PII tags, tenant_id, layout_version.<br><br><b>T7</b> Atomic snapshot. Then Athena / BI / PDF-from-gold.<br><br><b>AI</b> drafts a JSON contract (sample pages). ECR interpreter applies it. No exec of generated Python.<br><br><b>Lines</b> exist only on the Airflow row so labels never sit on arrows." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;whiteSpace=wrap;overflow=hidden;fontColor=#232F3E;" vertex="1" parent="legbox">
          <mxGeometry x="16" y="48" width="408" height="960" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
