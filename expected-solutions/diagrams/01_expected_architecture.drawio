        <mxCell id="legend" value="How to read this diagram" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#F7F9FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1500" y="110" width="460" height="1040" as="geometry"/>
        </mxCell>
        <mxCell id="legendtext" value="T1 — S3 sensor on landing. Checksum is the DAG idempotency key.&#xa;&#xa;T2–T3 — ECS Python classifier. Branch: PDF, Excel, SQLite/Word, or quarantine.&#xa;&#xa;T4 — Workers, never the MWAA node. Mapped ECS + Textract for huge PDFs. Glue PySpark for large Excel. Python paging for SQLite.&#xa;&#xa;T5–T6 — Glue PySpark writes Iceberg silver then gold. Types, PII tags, tenant_id, layout_version.&#xa;&#xa;T7 — Atomic snapshot. Then Athena / BI / PDF from gold.&#xa;&#xa;AI drafts a JSON contract from sample pages. An ECR image applies it. Do not exec generated Python.&#xa;&#xa;Arrows exist only on the Airflow row so labels never sit on lines." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=Helvetica;fontColor=#232F3E;whiteSpace=wrap;overflow=hidden;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1520" y="160" width="420" height="960" as="geometry"/>
        </mxCell>
      </root>
