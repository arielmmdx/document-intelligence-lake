        </mxCell>
        <mxCell id="foot" value="Medallion rule: quality and access increase left → right; sensitivity of raw bytes stays in landing/bronze/quarantine. Silver/gold are derived tables with KMS and Lake Formation. Publish is an Iceberg snapshot (or equivalent manifest), not a copy into current/." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;whiteSpace=wrap;overflow=hidden;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="220" y="1310" width="1900" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="layers" name="02 Layer contracts">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2t" value="Medallion layers — what belongs where" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontFamily=Helvetica;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2s" value="Each layer has a different contract, CMK, IAM role, and consumer. Do not collapse them into one bucket." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2l" value="" style="line;strokeWidth=3;html=1;strokeColor=#FF9900;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1800" height="8" as="geometry" />
        </mxCell>
        <mxCell id="b-100" value="&lt;b&gt;Landing (raw)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose.&lt;/b&gt; Keep the original file forever (legal hold / Object Lock).&lt;br&gt;&lt;b&gt;Contents.&lt;/b&gt; PDF/Excel/Word/SQLite/text as uploaded. Checksum, tenant prefix, content-type metadata.&lt;br&gt;&lt;b&gt;AWS.&lt;/b&gt; S3 landing, Transfer Family, API Gateway, Lambda checksum, EventBridge, KMS-raw, optional Macie.&lt;br&gt;&lt;b&gt;Who.&lt;/b&gt; ingest-task-role write; break-glass read. &lt;b&gt;Not&lt;/b&gt; Athena analysts.&lt;br&gt;&lt;b&gt;Success.&lt;/b&gt; Object stored once, immutable, accounted for." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=10;fontSize=12;fontFamily=Helvetica;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1760" height="165" as="geometry" />
        </mxCell>
        <mxCell id="b-280" value="&lt;b&gt;Bronze&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose.&lt;/b&gt; Make the lake &lt;i&gt;operable&lt;/i&gt;: what arrived, in what shape, is it scanned, how many pages.&lt;br&gt;&lt;b&gt;Contents.&lt;/b&gt; Inventory table; optional Textract JSON / page images as derivatives (still raw-class).&lt;br&gt;&lt;b&gt;AWS.&lt;/b&gt; ECS Fargate classifier, DynamoDB doc registry, Glue Data Catalog bronze_inventory, S3 bronze prefix, quarantine bucket.&lt;br&gt;&lt;b&gt;Who.&lt;/b&gt; classifier and layout roles. Still not a BI source.&lt;br&gt;&lt;b&gt;Success.&lt;/b&gt; Every landing object has a row; poison goes to quarantine with a reason code." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=10;fontSize=12;fontFamily=Helvetica;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1760" height="165" as="geometry" />
        </mxCell>
        <mxCell id="b-460" value="&lt;b&gt;Layout intelligence (between bronze and silver)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose.&lt;/b&gt; Compress 10k pages into a reusable &lt;i&gt;extraction contract&lt;/i&gt; (not generated Python in prod).&lt;br&gt;&lt;b&gt;Contents.&lt;/b&gt; Fingerprint, contract JSON, human approval record, pinned ECR digest of the interpreter.&lt;br&gt;&lt;b&gt;AWS.&lt;/b&gt; Textract Analyze on stratified samples, Bedrock for draft mapping, DynamoDB registry, S3 artifacts, Ground Truth / review UI.&lt;br&gt;&lt;b&gt;Who.&lt;/b&gt; layout-task-role; reviewers via SSO. Model cannot PutObject to silver.&lt;br&gt;&lt;b&gt;Success.&lt;/b&gt; Known forms skip AI; unknown forms emit a versioned contract; drift mid-document splits work." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=10;fontSize=12;fontFamily=Helvetica;fillColor=#E0F2F1;strokeColor=#00796B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1760" height="165" as="geometry" />
        </mxCell>
        <mxCell id="b-640" value="&lt;b&gt;Extract (compute that writes silver)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose.&lt;/b&gt; Apply the contract in bounded, retryable units.&lt;br&gt;&lt;b&gt;Routing.&lt;/b&gt; ECS Python (small docs, SQLite paging) · Step Functions map + Textract async (huge/scanned PDF) · Glue Spark (large Excel/CSV) · EMR only if Glue is not enough.&lt;br&gt;&lt;b&gt;AWS.&lt;/b&gt; ECR images, ECS/Fargate, SQS + DLQ, Glue jobs, optional EMR, KMS data keys cached at job grain (not per page).&lt;br&gt;&lt;b&gt;Success.&lt;/b&gt; Staging prefix per run_id; retries idempotent; tables spanning pages use overlap + reduce." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=10;fontSize=12;fontFamily=Helvetica;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1760" height="165" as="geometry" />
        </mxCell>
        <mxCell id="b-820" value="&lt;b&gt;Silver&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose.&lt;/b&gt; Conformed, typed, queryable facts with lineage to page/object.&lt;br&gt;&lt;b&gt;Grain examples.&lt;/b&gt; form instance, table row, text chunk — declared per contract. Always tenant_id + layout_version + pii_class.&lt;br&gt;&lt;b&gt;AWS.&lt;/b&gt; S3 silver (Iceberg), Glue job verify, Glue Catalog, Lake Formation optional at this layer.&lt;br&gt;&lt;b&gt;Who.&lt;/b&gt; extractor/glue-extract-role write staging; publish role commits snapshot; analysts only if LF allows.&lt;br&gt;&lt;b&gt;Success.&lt;/b&gt; Independent verification of serialized files; no partial current/ folder." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=10;fontSize=12;fontFamily=Helvetica;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1760" height="165" as="geometry" />
        </mxCell>
        <mxCell id="b-1000" value="&lt;b&gt;Gold&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose.&lt;/b&gt; Business entities and metrics for consumption (claim, shipment, invoice line).&lt;br&gt;&lt;b&gt;Contents.&lt;/b&gt; Conformed keys across PDF and Excel; slowly changing layout handled as versioned attributes.&lt;br&gt;&lt;b&gt;AWS.&lt;/b&gt; Glue Spark model job, S3 gold, Glue Catalog gold DB, Lake Formation grants, KMS-gold.&lt;br&gt;&lt;b&gt;Who.&lt;/b&gt; glue-model-role write; athena-analyst-role and Tableau role read via LF.&lt;br&gt;&lt;b&gt;Success.&lt;/b&gt; One published snapshot Athena can see; previous snapshot remains readable." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=10;fontSize=12;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="1760" height="165" as="geometry" />
        </mxCell>
        <mxCell id="b-1180" value="&lt;b&gt;Serve (not a medallion layer — consumption)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose.&lt;/b&gt; SQL, BI, regenerated PDF, website — all from gold (or approved silver views).&lt;br&gt;&lt;b&gt;AWS.&lt;/b&gt; Athena workgroups, QuickSight and/or Tableau Athena connector, API Gateway + Cognito, ECS PDF renderer, S3 serving-pdf.&lt;br&gt;&lt;b&gt;Who.&lt;/b&gt; Humans via Identity Center + MFA. Apps via Cognito/IAM. render-pdf-role cannot read landing.&lt;br&gt;&lt;b&gt;Success.&lt;/b&gt; Freshness SLO per product; website never lists the raw bucket." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=10;fontSize=12;fontFamily=Helvetica;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1180" width="1760" height="165" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="security" name="03 Identity and zones">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3t" value="Identity, keys, and data zones" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontFamily=Helvetica;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3s" value="Humans = IAM Identity Center + MFA. Jobs = task roles. CI cannot read landing. KMS is per zone, not per page." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3l" value="" style="line;strokeWidth=3;html=1;strokeColor=#FF9900;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1800" height="8" as="geometry" />
        </mxCell>
        <mxCell id="g-h" value="Human access" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=11;fontFamily=Helvetica;container=1;collapsible=0;strokeWidth=2;arcSize=8;fillColor=#FFEBEE;strokeColor=#DD344C;fontColor=#DD344C;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="560" height="420" as="geometry" />
        </mxCell>
        <mxCell id="h-sso" value="Identity Center" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iam_identity_center;fontFamily=Helvetica;" vertex="1" parent="g-h">
          <mxGeometry x="40" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="h-mfa" value="MFA / app users" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;fontFamily=Helvetica;" vertex="1" parent="g-h">
          <mxGeometry x="200" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="h-lf" value="Lake Formation" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lake_formation;fontFamily=Helvetica;" vertex="1" parent="g-h">
          <mxGeometry x="360" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="h-n" value="Permission sets: analyst (gold), reviewer (artifacts), break-glass (time-bound raw).&#xa;Tableau uses a tenant-scoped service role equivalent to analyst — not a personal access key." style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;size=16;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="g-h">
          <mxGeometry x="20" y="200" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="g-j" value="Job identities (ECS / Glue / Lambda)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=11;fontFamily=Helvetica;container=1;collapsible=0;strokeWidth=2;arcSize=8;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#E65100;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="560" height="420" as="geometry" />
        </mxCell>
        <mxCell id="j-iam" value="IAM roles" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.role;fontFamily=Helvetica;" vertex="1" parent="g-j">
          <mxGeometry x="40" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="j-ecs" value="Task role" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;fontFamily=Helvetica;" vertex="1" parent="g-j">
          <mxGeometry x="200" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="j-glue" value="Glue job role" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;fontFamily=Helvetica;" vertex="1" parent="g-j">
          <mxGeometry x="360" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="j-n" value="ingest: Put landing+inventory&#xa;layout: Get landing, Textract/Bedrock, Put contracts&#xa;extract: Get landing+contracts, Put silver staging&#xa;model: Get silver, Put gold, Update catalog&#xa;render: Get gold, Put serving-pdf&#xa;CI/CD: Push ECR only" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;size=16;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="g-j">
          <mxGeometry x="20" y="180" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="g-k" value="Encryption and network" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=11;fontFamily=Helvetica;container=1;collapsible=0;strokeWidth=2;arcSize=8;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#2E7D32;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1240" y="110" width="560" height="420" as="geometry" />
        </mxCell>
        <mxCell id="k-kms" value="CMK per zone" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kms;fontFamily=Helvetica;" vertex="1" parent="g-k">
          <mxGeometry x="40" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="k-vpc" value="VPC private" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc;fontFamily=Helvetica;" vertex="1" parent="g-k">
          <mxGeometry x="200" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="k-ep" value="Interface/Gateway EP" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;fontFamily=Helvetica;" vertex="1" parent="g-k">
          <mxGeometry x="360" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="k-n" value="CMKs: landing, silver, gold, artifacts, logs.&#xa;Envelope encryption; cache data keys at job/object grain.&#xa;No public S3. ECR scan on push. Secrets Manager for non-KMS secrets." style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;size=16;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="g-k">
          <mxGeometry x="20" y="200" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="g-z" value="S3 buckets (separate accounts optional; separate CMKs required)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=11;fontFamily=Helvetica;container=1;collapsible=0;strokeWidth=2;arcSize=8;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#1565C0;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1760" height="280" as="geometry" />
        </mxCell>
        <mxCell id="bkt0" value="landing" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fontFamily=Helvetica;" vertex="1" parent="g-z">
          <mxGeometry x="40" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="bkt1" value="quarantine" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fontFamily=Helvetica;" vertex="1" parent="g-z">
          <mxGeometry x="250" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="bkt2" value="bronze" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fontFamily=Helvetica;" vertex="1" parent="g-z">
          <mxGeometry x="460" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="bkt3" value="artifacts" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fontFamily=Helvetica;" vertex="1" parent="g-z">
          <mxGeometry x="670" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="bkt4" value="silver" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fontFamily=Helvetica;" vertex="1" parent="g-z">
          <mxGeometry x="880" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="bkt5" value="gold" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fontFamily=Helvetica;" vertex="1" parent="g-z">
          <mxGeometry x="1090" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="bkt6" value="serving-pdf" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fontFamily=Helvetica;" vertex="1" parent="g-z">
          <mxGeometry x="1300" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="bkt7" value="logs/audit" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fontFamily=Helvetica;" vertex="1" parent="g-z">
          <mxGeometry x="1510" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="z-n" value="Prefix standard: s3://bucket/tenant_id=…/dt=…/document_id=…   Iceberg metadata lives with silver/gold. Quarantine never under a serving prefix." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;whiteSpace=wrap;overflow=hidden;fontColor=#232F3E;" vertex="1" parent="g-z">
          <mxGeometry x="20" y="200" width="1700" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="compute" name="04 Compute and AI">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4t" value="Compute routing and AI boundary" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontFamily=Helvetica;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p4s" value="Decision is driven by format and size, not by a preferred brand. Glue jobs are the default Spark plane." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p4l" value="" style="line;strokeWidth=3;html=1;strokeColor=#FF9900;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1800" height="8" as="geometry" />
